{
  "name": "event-management-platform",
  "version": "1.0.0",
  "private": true,
  "description": "EntryMySlot — Event booking & turf management platform",
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node dist/index.js\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "knex migrate:latest",
    "seed:admin": "node dist/seeds/admin.js",
    "test": "jest",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\""
  },
  "keywords": [
    "event-booking",
    "turf-management",
    "ems"
  ],
  "license": "MIT",
  "dependencies": {
    "typescript": "^7.0.2"
  }
}
